{
  "name": "douyin-dl",
  "version": "0.2.0",
  "description": "抖音单条视频下载器（Kazumi 风格）",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist:msi": "electron-builder --win msi",
    "dist:win": "electron-builder --win nsis zip"
  },
  "author": "LCX",
  "license": "MIT",
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.lcx.douyindl",
    "productName": "DouyinDownloader",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "electronVersion": "33.4.11",
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "artifactName": "DouyinDownloader-Setup-${version}.exe"
    }
  }
}